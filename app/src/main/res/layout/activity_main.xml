<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#111111">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ExamAssist"
        android:textSize="26sp"
        android:textColor="#00FF88"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Groq-powered overlay"
        android:textSize="13sp"
        android:textColor="#888888"
        android:layout_marginBottom="32dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#CCCCCC"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:fontFamily="monospace"
        android:background="#1A1A1A"
        android:padding="16dp"
        android:layout_marginBottom="32dp"
        android:text="Checking permissions..." />

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="1. Enable Accessibility Service"
        android:backgroundTint="#00FF88"
        android:textColor="#000000"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnOverlay"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="2. Allow Display Over Other Apps"
        android:backgroundTint="#00AA55"
        android:textColor="#000000"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#555555"
        android:textSize="11sp"
        android:text="After both are enabled, open your exam app.\nThe answer overlay appears bottom-left.\nEdit GROQ_API_KEY in AccessibilityReaderService.java before building."
        android:lineSpacingExtra="3dp" />

</LinearLayout>
